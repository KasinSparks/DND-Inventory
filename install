folder_name=/home/dnd/DND-Inventory
site_data_folder=/home/dnd/site_data


echo "Starting install..."

ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

apt update && apt install -y \
    nginx python3-full python3-pip python3-venv sqlite3 vim git tmux

echo "DONE."


echo "Creating site data directories..."
mkdir -p -m 740 $site_data_folder/instance/database
mkdir -p -m 740 $site_data_folder/instance/uploads/items
mkdir -p -m 740 $site_data_folder/instance/uploads/users
echo "DONE."

echo "Initilizing SQLite3 Database..."
sqlite3 $site_data_folder/instance/database/db.sqlite < /$folder_name/schema.sql
echo "DONE."

echo "Copying example configuration file..."
cp $folder_name/example.cfg $site_data_folder/instance/production.cfg
echo "DONE."

echo "Setting permissions on files and directories..."
chown dnd -R $site_data_folder/instance/uploads
chown dnd -R $site_data_folder/instance/database
chmod 740 -R $site_data_folder/instance/uploads
chmod 740 $site_data_folder/instance/database
chmod 640 $site_data_folder/instance/database/db.sqlite
chown dnd -R $folder_name
echo "Done."

cat $folder_name/dnd_nginx.conf >> /etc/nginx/nginx.conf

echo "Creating python virtual environment..."
su -c 'python3 -m venv /home/dnd/DND-Inventory/src/.venv' dnd
echo "DONE."

echo "Activating python virtual environment..."
su -c 'source /home/dnd/DND-Inventory/src/.venv/bin/activate' dnd
echo "DONE."

echo "Installing python requirements..."
su -c '/home/dnd/DND-Inventory/src/.venv/bin/pip3 install --requirement /home/dnd/DND-Inventory/requirements.txt' dnd
echo "DONE."

echo "Install Finished!"

$folder_name/start
